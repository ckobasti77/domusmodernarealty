# Copy to .env.local (never commit it). `npx convex dev` fills the first three.

# Deployment used by `npx convex dev`
CONVEX_DEPLOYMENT=dev:your-deployment-name

# Convex client URL (public site and admin)
NEXT_PUBLIC_CONVEX_URL=https://your-deployment-name.eu-west-1.convex.cloud

# Written by `npx convex dev`; the app does not read it
NEXT_PUBLIC_CONVEX_SITE_URL=https://your-deployment-name.eu-west-1.convex.site

# Absolute public origin for canonical URLs, hreflang, the sitemap and share images.
# Defaults to http://localhost:3000. A Vercel production build falls back to
# VERCEL_PROJECT_PRODUCTION_URL and fails if neither is set.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional, for `npm run test:e2e` on machines without night-run/state/admin.json:
# an admin account on the dev deployment.
# E2E_ADMIN_EMAIL=
# E2E_ADMIN_PASSWORD=
