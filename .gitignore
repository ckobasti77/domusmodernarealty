# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# night run + QA artifacts
/night-run/logs/
/night-run/state/*.json
/night-run/state/skills-inventory.md
/night-run/STATUS.md
/.shots/
/test-results/
/playwright-report/
/blob-report/
/media-src/*
!/media-src/.gitkeep
!/media-src/README.md
.auth-keys.json

# generated by predev/prebuild
/public/maplibre/

# local run logs
.verify.log
.next-start.log
